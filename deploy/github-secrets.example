# GitHub → Settings → Secrets and variables → Actions
# Create once after linking the repo to a Vercel project.

# From https://vercel.com/account/tokens
VERCEL_TOKEN=

# From .vercel/project.json after running: npx vercel link
# Or Vercel → Project → Settings → General
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# App env vars: set in Vercel Dashboard → Project → Settings → Environment Variables
# (Production). See deploy/vercel-env.example — do NOT only put them in GitHub;
# `vercel build` reads them from the linked Vercel project.
