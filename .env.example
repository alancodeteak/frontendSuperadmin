# Same-origin API path — required for tunnel (avoids CORS).
# Browser → https://superadmin.yaadro.online/api/... → Next.js rewrite → proxy target
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin for Next.js rewrite proxy (no /api suffix)
API_PROXY_TARGET=https://superadmin-api.yaadro.online

# Admin API key — sent as `x-api-key` on all admin-api requests
# NEXT_PUBLIC_ is required so the browser can attach the header (rewrites forward it)
NEXT_PUBLIC_ADMIN_API_KEY=
# Optional server-only alias used by middleware + search sync
ADMIN_API_KEY=

# Shop reports (dms-api)
DMS_API_PROXY_TARGET=http://localhost:3001
NEXT_PUBLIC_DMS_API_BASE_URL=/dms-api

# Named Cloudflare tunnel hostname (enables Next.js HMR over this host)
NEXT_PUBLIC_TUNNEL_HOST=superadmin.yaadro.online
NEXT_PUBLIC_APP_URL=https://superadmin.yaadro.online
NEXT_PUBLIC_APP_NAME=Restaurant Superadmin

# Set to false for real OTP authentication via API
NEXT_PUBLIC_DEVELOPMENT_MODE=false

# Numverify (apilayer) access key — carrier detection for shop phone field
NEXT_PUBLIC_NUMVERIFY_ACCESS_KEY=

# Google Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Meilisearch — powers right-sidebar global search (shops, riders, POS, invoices, pages)
# When unset, search falls back to live admin-api federated queries.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_SUPERADMIN=superadmin
